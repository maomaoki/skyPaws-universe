# 依赖安装产物
node_modules/
.pnpm-store/

# 构建产物
dist/
build/
out/
*.tsbuildinfo

# Go 编译产物
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# 测试覆盖率
coverage/

# 构建 / 工具缓存
.cache/
.turbo/
.eslintcache

# 环境变量：真实密钥只留在本机，模板文件入库
.env
.env.*
!.env.example
!.env.*.example

# 配置文件：真实配置只留在本机，模板文件入库
config.yaml
!config.example.yaml

# 私钥与证书（read 工具同样把它们标为敏感文件）
*.pem
*.key

# 日志
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# 编辑器与系统
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 临时文件
*.tmp
tmp/
